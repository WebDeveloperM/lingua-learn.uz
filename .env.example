SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram link shown to users whose accounts are waiting for admin activation
ADMIN_TELEGRAM_URL=https://t.me/your_username

# Speaking practice: AI feedback on the students' spoken answers. Leave both keys empty and the practice still works,
# but the results page says the AI feedback is not set up.
# Free: Groq (https://console.groq.com -> API Keys). It turns the recordings into text (Whisper) and, when there is no
# Claude key, writes the feedback too.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Paid: Claude (https://console.anthropic.com). When its key is there, Claude writes the feedback.
ANTHROPIC_API_KEY=
# The model that writes the feedback and the language of the feedback (the "Try saying" sentence is always English).
SPEAKING_AI_MODEL=claude-sonnet-5-5
SPEAKING_FEEDBACK_LANGUAGE=English
# Only needed when the API is reached through a proxy or gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# https (docker compose only): browsers give the microphone of the Speaking practice to https pages only.
# The addresses and names people open the site at, besides localhost: the https certificate is made for them
# (several: 192.168.2.72,192.168.2.80). When this computer's address changes, put the new one here and run
# "docker compose up -d".
HTTPS_HOSTS=192.168.2.72
# The port of the https address: https://192.168.2.72:8443/
HTTPS_PORT=8443
